{
  "services": {
    "frontend": {
      "root": "frontend/",
      "installCommand": "npm install --legacy-peer-deps"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "server:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
